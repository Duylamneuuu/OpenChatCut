#!/usr/bin/env node
// Generate src/gl/fx/communityLuts.ts from ~/workspace/luts/catalog.json
// (produced by the free-LUT hunt). Re-run after every hunt:
//
//   npx tsx scripts/gen-lut-registry.mts
//
// The .cube files themselves must live in <repo>/public/luts/<pack-dir>/.

import { readFileSync, writeFileSync, existsSync } from 'node:fs';
import { join, dirname } from 'node:path';
import { fileURLToPath } from 'node:url';

const root = join(dirname(fileURLToPath(import.meta.url)), '..');
const catalogPath = join(process.env.HOME ?? '~', 'workspace', 'luts', 'catalog.json');
const outPath = join(root, 'src', 'gl', 'fx', 'communityLuts.ts');

interface LutEntry {
  file: string;
  name: string;
  mood?: string;
}
interface Pack {
  source: string;
  license: string;
  dir: string;
  luts: LutEntry[];
}
interface Catalog {
  packs: Pack[];
}

function slug(s: string): string {
  return s
    .toLowerCase()
    .replace(/\.cube$/i, '')
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-+|-+$/g, '')
    .slice(0, 60);
}

function esc(s: string): string {
  return s.replace(/\\/g, '\\\\').replace(/'/g, "\\'").replace(/\n/g, ' ');
}

const catalog: Catalog = JSON.parse(readFileSync(catalogPath, 'utf8'));
const seen = new Set<string>();
const entries: string[] = [];

for (const pack of catalog.packs) {
  for (const lut of pack.luts) {
    const id = `community:${slug(pack.dir)}-${slug(lut.file)}`;
    if (seen.has(id)) continue;
    seen.add(id);
    const cubePath = `/luts/${pack.dir}/${lut.file}`;
    const desc = `${lut.mood ? lut.mood + ' · ' : ''}Free LUT (${pack.license}) via ${pack.source}.`;
    entries.push(
      `  '${id}': {\n` +
        `    id: '${id}',\n` +
        `    name: '${esc(lut.name)}',\n` +
        `    desc: '${esc(desc)}',\n` +
        `    frag: lutFrag,\n` +
        `    cube: '${cubePath}',\n` +
        `    props: [{ key: 'intensity', label: 'Intensity', default: 0.85, min: 0, max: 1, step: 0.01 }],\n` +
        `  },`,
    );
  }
}

const header = `// GENERATED by scripts/gen-lut-registry.mts — do not hand-edit.
// Source: ~/workspace/luts/catalog.json (${entries.length} community LUTs).
import lutFrag from './lut.frag.ts';
import type { FxDef } from './uniforms';

export const COMMUNITY_LUT_EFFECTS: Record<string, FxDef> = {
${entries.join('\n')}
};
`;

writeFileSync(outPath, header, 'utf8');
console.log(`wrote ${outPath} with ${entries.length} community LUTs`);
if (!existsSync(join(root, 'public', 'luts'))) {
  console.warn('NOTE: public/luts/ does not exist yet — copy the .cube files there.');
}
